[Unit]
Description=Kvit-App Receipts & Billing Processing Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/kvit_test
EnvironmentFile=/var/www/kvit_test/.env
ExecStart=/var/www/kvit_test/venv/bin/python app.py

# Auto-restart on failure
Restart=always
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
