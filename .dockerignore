# Git
.git
.gitignore
.github

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
*.pyc
*.pyo
*.pyd

# Secrets & Environment variables
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Database & Storage
data.sqlite3
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
receipts/
logs/
data/receipts/
data/uploads/
data/certbot/
data/nginx-logs/
data/api-logs/
data/worker-logs/
data/processing/
data/spool/
data/failed/
data/*.sqlite3*
data/maintenance.flag
!data/*.json

# Raw data & Spreadsheets
*.xls
*.xlsx
*.csv
!accounts_all.xls
!accounts_all.xlsx
!static/files/*.xls
!static/files/*.xlsx
!static/files/*.csv

# Tests & Benchmarks
tests/
test_*.pdf
test_*.py
benchmarks/
coverage.xml
.coverage
htmlcov/

# Documentation & AI assistant state
.ai/
.foryou/
*.md
LICENSE
