# Шаблон переменных окружения (скопируйте в .env)

# Хост и порт
HOST=127.0.0.1
PORT=8000
# Доверять заголовкам прокси (X-Forwarded-For) при работе за Nginx / IIS / Traefik
TRUST_PROXY=false
TRUSTED_PROXIES=127.0.0.1,::1

# Опциональный встроенный TLS/HTTPS (если запуск напрямую без Reverse Proxy)
USE_HTTPS=false
# SSL_CERT_PATH=/path/to/fullchain.pem
# SSL_KEY_PATH=/path/to/privkey.pem

# gRPC микросервис (обязательный секрет, сгенерируйте через: python -c "import secrets; print(secrets.token_hex(32))")
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_API_KEY=your_generated_64char_secret_key_here
GRPC_USE_TLS=false
# GRPC_CERT_PATH=/path/to/server.crt
# GRPC_KEY_PATH=/path/to/server.key

# Аутентификация администратора (рекомендуется хранить хеш PBKDF2)
# Сгенерировать хеш пароля: python -c "from services.security.auth_service import hash_password; print(hash_password('ваш_пароль'))"
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$your_salt_here$your_hash_here
# Либо открытый пароль (для локальной разработки):
# ADMIN_PASSWORD=your_secure_password
SESSION_LIFETIME=86400

# WebSocket
WS_SOCKET_TIMEOUT=60.0

# Лимиты запросов (Rate Limiting)
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SEARCH=60

# Throttling по IP
THROTTLE_MAX_CONCURRENT=5
THROTTLE_BURST_RPS=10

# OCR (Распознавание сканов)
OCR_ENABLED=true
OCR_LANGUAGES=rus+kaz+eng
OCR_DPI=200

# ============================================================
# Пути к данным и отдельному диску хранилища
# ============================================================
# В Debian/Linux для второго диска укажите точку монтирования, например:
# RECEIPTS_DIR=/mnt/storage_disk/receipts
# DB_PATH=/mnt/storage_disk/data/data.sqlite3
#
# В Windows для отдельного диска:
# RECEIPTS_DIR=D:/receipts
# DB_PATH=D:/kvit_data/data.sqlite3

RECEIPTS_DIR=receipts
DB_PATH=data.sqlite3

# Логирование
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
