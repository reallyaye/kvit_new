# ==============================================================================
# Переменные окружения для Kvit-App (Production / Staging / Development)
# ==============================================================================

# Окружение: 'production', 'staging' или 'development'
APP_ENV=production

# Секретный ключ для подписи сессий и CSRF токенов (сгенерируйте через: openssl rand -hex 32)
SECRET_KEY=generate_your_secure_random_secret_key_here_min_32_chars

# Хеш пароля администратора (сгенерируйте через: python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())")
ADMIN_PASSWORD_HASH=generate_admin_sha256_hash_here

# API ключ для доступа к защищенному gRPC сервису
GRPC_API_KEY=generate_secure_grpc_api_key_here

# ────────────────────── База данных ──────────────────────
# Тип базы данных: 'postgres' для production, 'sqlite' для dev/test
DB_TYPE=postgres

# PostgreSQL параметры (для standalone docker-compose.yml)
POSTGRES_DB=kvit_db
POSTGRES_USER=kvit_admin
POSTGRES_PASSWORD=generate_super_strong_postgres_password_here

# Полная строка подключения (для docker-compose.prod.yml или внешнего сервера):
DATABASE_URL=postgresql://kvit_admin:generate_super_strong_postgres_password_here@postgres:5432/kvit_db

# ────────────────────── Очередь задач и Redis ────────────
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
QUEUE_VISIBILITY_TIMEOUT=600

# ────────────────────── Воркеры обработки PDF и OCR ──────
# Количество параллельных воркеров задач
WORKER_COUNT=4
# Максимум одновременных процессов распознавания текста (OCR) для защиты CPU
MAX_OCR_CONCURRENT_WORKERS=2

# ────────────────────── Сеть и Nginx X-Accel ──────────────
TRUST_PROXY=true
ENABLE_X_ACCEL_REDIRECT=true
X_ACCEL_PREFIX=/internal_receipts/
RECEIPTS_DIR=/app/receipts
LOG_LEVEL=INFO
